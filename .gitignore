# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Runtime/cache state inside tracked configs
config/**/*.log
config/**/*.cache
config/nvim/undodir/
config/qalculate/qalc.history
config/kitty/*.bak

# Wallpaper state: rewritten (megabytes at a time) every wallpaper change.
# Pick a wallpaper on first run — see "Wallpaper" in the README.
config/hypr/wallpaper_effects/.wallpaper_current
config/hypr/wallpaper_effects/.wallpaper_modified

# OpenRGB: default.orp is the RGB profile and IS tracked. OpenRGB.json is
# ~76 KB of auto-generated device-detector enumeration plus churny state.
config/OpenRGB/OpenRGB.json
config/OpenRGB/logs/

# Secrets — never commit, even if an aws/ dir gets added later
aws/credentials
aws/sso/
aws/cli/
**/.env
**/*.pem
**/*.key
