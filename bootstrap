#!/usr/bin/env bash
# One-step setup for a fresh archinstall system (run as your normal sudo user):
#
#   curl -fsSL https://raw.githubusercontent.com/JoshuaHayesWasHere/dotfiles/arch/bootstrap | bash
#
# Safe to re-run. docs/machine.md explains the pieces; anything interactive
# (gh auth, wallpaper) is left for the end and printed as a reminder.
set -euo pipefail

REPO_URL=https://github.com/JoshuaHayesWasHere/dotfiles.git
BRANCH=arch
DOTS="$HOME/dotfiles"

log() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }

[ "$(id -u)" -ne 0 ] || { echo "Run as your user, not root (makepkg refuses root)." >&2; exit 1; }
sudo -v
# Keep sudo alive for the whole run
while true; do sudo -n true; sleep 50; kill -0 "$$" 2>/dev/null || exit; done &

log "System update + base tools"
sudo pacman -Syu --needed --noconfirm base-devel git curl

log "yay"
if ! command -v yay >/dev/null; then
    tmp=$(mktemp -d)
    git clone --depth 1 https://aur.archlinux.org/yay-bin.git "$tmp/yay"
    (cd "$tmp/yay" && makepkg -si --noconfirm)
    rm -rf "$tmp"
fi

log "Fallback kernel preset"
# archinstall writes a UKI preset for linux only. Derive linux-lts's from it
# before the package goes in, or its hook builds a plain initramfs that
# systemd-boot never lists.
[ -e /etc/mkinitcpio.d/linux-lts.preset ] ||
    sed "s/-linux\b/-linux-lts/g; s/'linux'/'linux-lts'/" /etc/mkinitcpio.d/linux.preset |
    sudo tee /etc/mkinitcpio.d/linux-lts.preset >/dev/null

log "System tuning"
# AUR builds on every core, without the -debug split packages that Arch's
# default makepkg.conf turns on. $(nproc) stays literal: makepkg expands it.
# shellcheck disable=SC2016
printf 'MAKEFLAGS="-j$(nproc)"\nOPTIONS+=(!debug)\n' | sudo tee /etc/makepkg.conf.d/local.conf >/dev/null
mapfile -t debug_pkgs < <(pacman -Qq | grep -- '-debug$' || true)
[ "${#debug_pkgs[@]}" -eq 0 ] || sudo pacman -Rns --noconfirm "${debug_pkgs[@]}"
sudo sed -i 's/^ParallelDownloads = .*/ParallelDownloads = 10/' /etc/pacman.conf
grep -q '^--country' /etc/xdg/reflector/reflector.conf ||
    echo '--country US' | sudo tee -a /etc/xdg/reflector/reflector.conf >/dev/null
# Swap is zram only, so swapping is cheap: the Arch wiki's values for it
printf 'vm.swappiness = 180\nvm.watermark_boost_factor = 0\nvm.watermark_scale_factor = 125\nvm.page-cluster = 0\n' |
    sudo tee /etc/sysctl.d/99-vm-zram-parameters.conf >/dev/null

log "Packages"
pkgs=(
    # shell + CLI
    zsh ripgrep bat eza fd zoxide fzf starship jq uv mise git-delta less
    ttf-meslo-nerd fastfetch pokemon-colorscripts-git wl-clipboard aws-cli-v2
    github-cli openssh man-db unzip neovim tmux kitty btop htop cava libqalculate
    shellcheck
    # desktop stack
    hyprland hyprland-guiutils waybar-git rofi swaync wlogout quickshell awww
    hyprlock hypridle hyprpolkitagent grim slurp swappy playerctl wireplumber
    cliphist libnotify libcanberra xdg-desktop-portal-hyprland
    xdg-desktop-portal-gtk kvantum qt5ct qt6ct qt5-wayland sddm xorg-xrandr
    thunar gvfs tumbler network-manager-applet blueman nwg-displays nwg-look
    xsettingsd
    # fonts, cursor and themes the configs name
    inter-font ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji
    bibata-cursor-theme-bin flat-remix-gtk flat-remix
    # audio (pipewire-audio holds the ALSA plugin; without it there are no
    # sound cards), Bluetooth, Intel graphics
    pipewire-audio pipewire-pulse pipewire-alsa rtkit alsa-utils bluez
    bluez-utils vulkan-intel intel-media-driver
    # system
    keyd earlyoom smartmontools reflector pacman-contrib linux-lts
)
# --removemake: build-only dependencies (rust, clang, cmake...) do not linger as orphans
yay -S --needed --noconfirm --removemake "${pkgs[@]}"

log "Dotfiles"
if [ -d "$DOTS/.git" ]; then
    git -C "$DOTS" fetch origin && git -C "$DOTS" checkout "$BRANCH" && git -C "$DOTS" pull --ff-only
else
    git clone -b "$BRANCH" "$REPO_URL" "$DOTS"
fi
# --force moves archinstall's default ~/.bashrc etc. aside instead of failing
"$DOTS/install" --force
# user-dirs.dirs names these; the wallpaper picker reads ~/Pictures/wallpapers
mkdir -p "$HOME/Documents" "$HOME/Downloads" "$HOME/Pictures/wallpapers"

log "Oh My Zsh + plugins"
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c \
        "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi
plugdir="$HOME/.oh-my-zsh/custom/plugins"
[ -d "$plugdir/zsh-autosuggestions" ] || git clone --depth 1 https://github.com/zsh-users/zsh-autosuggestions "$plugdir/zsh-autosuggestions"
[ -d "$plugdir/zsh-syntax-highlighting" ] || git clone --depth 1 https://github.com/zsh-users/zsh-syntax-highlighting "$plugdir/zsh-syntax-highlighting"

log "Node"
# mise installs the Node named in config/mise/config.toml (linked above) and
# shims it onto PATH; Claude Code's SessionStart hook runs gh-axi
mise install
mise exec -- npm install -g gh-axi

log "Claude Code"
command -v claude >/dev/null || [ -x "$HOME/.local/bin/claude" ] || \
    curl -fsSL https://claude.ai/install.sh | bash

log "System links: keyd + SDDM"
sudo mkdir -p /etc/keyd /etc/sddm/scripts /etc/sddm.conf.d
sudo ln -sfn "$DOTS/keyd/default.conf" /etc/keyd/default.conf
sudo ln -sfn "$DOTS/config/sddm/Xsetup" /etc/sddm/scripts/Xsetup
printf '[X11]\nDisplayCommand=/etc/sddm/scripts/Xsetup\n' | sudo tee /etc/sddm.conf.d/10-monitors.conf >/dev/null

log "Services"
sudo systemctl enable keyd earlyoom smartd reflector.timer sddm NetworkManager \
    bluetooth paccache.timer
systemctl --user daemon-reload || true
# One missing unit fails the whole enable, so say so rather than hide it.
systemctl --user enable hub-watch.timer hub-watch-deep.timer ssh-agent.socket ||
    echo "warning: user units not enabled; after logging in, run:" \
        "systemctl --user enable --now hub-watch.timer hub-watch-deep.timer ssh-agent.socket" >&2
# docker-prune.timer is left off until Docker is installed

log "Default shell"
[ "$(getent passwd "$USER" | cut -d: -f7)" = /usr/bin/zsh ] || sudo chsh -s /usr/bin/zsh "$USER"

log "Done. Reboot, then:"
cat <<'EOF'
  gh auth login && gh auth setup-git     # GitHub credentials
  claude                                  # log in to Claude Code
  Super+End                               # pick a wallpaper (~/Pictures/wallpapers)
  Edit ~/dotfiles/claude/settings.json    # untracked, per-machine
EOF
