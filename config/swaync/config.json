{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "cssPriority": "user",

  "control-center-width": 440,
  "control-center-height": 700,
  "control-center-margin-top": 6,
  "notification-window-width": 340,
  "notification-icon-size": 28,
  "notification-body-image-height": 96,
  "notification-body-image-width": 96,
  "image-visibility": "when-available",

  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "transition-time": 150,
  "hide-on-action": true,
  "hide-on-clear": false,
  "notification-2fa-action": true,
  "script-fail-notify": true,

  "widgets": ["title", "dnd", "buttons-grid", "volume", "mpris", "notifications"],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "volume": {
      "label": "󰕾"
    },
    "mpris": {
      "image-size": 48,
      "image-radius": 8,
      "blacklist": ["playerctld"]
    },
    "buttons-grid": {
      "actions": [
        { "label": "󰐥", "command": "sh -c $HOME/.config/hypr/scripts/powermenu" },
        { "label": "󰌾", "command": "loginctl lock-session" },
        { "label": "󰍃", "command": "hyprctl dispatch 'hl.dsp.exit()'" },
        { "label": "󰝟", "command": "sh -c '$HOME/.config/hypr/scripts/volume mute'" },
        { "label": "󰂯", "command": "blueman-manager" }
      ]
    }
  }
}
