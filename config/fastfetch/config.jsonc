// What fastfetch shows. zshrc pipes a random Pokemon in as the logo for the
// shell greeting; run bare, fastfetch draws the distro logo instead.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 11 }
  },
  "modules": [
    "break",
    { "type": "os",       "key": "os",       "keyColor": "blue" },
    { "type": "kernel",   "key": "kernel",   "keyColor": "blue" },
    { "type": "packages", "key": "packages", "keyColor": "blue" },
    { "type": "uptime",   "key": "uptime",   "keyColor": "blue" },
    "break",
    { "type": "wm",       "key": "wm",       "keyColor": "magenta" },
    { "type": "terminal", "key": "terminal", "keyColor": "magenta" },
    { "type": "shell",    "key": "shell",    "keyColor": "magenta" },
    { "type": "editor",   "key": "editor",   "keyColor": "magenta" },
    "break",
    { "type": "cpu",      "key": "cpu",      "keyColor": "green" },
    { "type": "gpu",      "key": "gpu",      "keyColor": "green" },
    { "type": "memory",   "key": "memory",   "keyColor": "green" },
    { "type": "disk",     "key": "disk",     "keyColor": "green", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
