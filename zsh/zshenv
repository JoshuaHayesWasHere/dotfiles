# ~/.zshenv — environment for ALL zsh shells (login, interactive, scripts,
# systemd user services). Interactive-only config lives in ~/.zshrc.

# Auto-dedupe path-like arrays (replaces the old awk de-dupe hack in .zshrc)
typeset -U path PATH fpath FPATH

# Keep tool state out of ~ (XDG data dir)
export GOPATH="${XDG_DATA_HOME:-$HOME/.local/share}/go"

# node — put nvm's newest installed version on PATH without sourcing nvm.sh,
# so scripts and agent shells get node/npm/npx with zero startup cost.
# Interactive shells re-source real nvm in ~/.zshrc, which overrides this.
export NVM_DIR="$HOME/.nvm"
_node_bin=("$NVM_DIR"/versions/node/*/bin(Nn[-1]))

# PATH — later entries here take precedence (prepended)
path=(
    "$GOPATH/bin"
    "$HOME/.local/bin"
    $_node_bin
    $path
)
export PATH
unset _node_bin

# Portable helpers (aws switchers, clipboard, project shortcuts) — every shell,
# agent sessions included. Interactive-only config stays in ~/.zshrc.
[ -r "$HOME/dotfiles/zsh/functions.zsh" ] && source "$HOME/dotfiles/zsh/functions.zsh"
