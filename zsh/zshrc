# Dedupe PATH
export PATH=$(echo "$PATH" | tr ':' '\n' | awk '!seen[$0]++' | tr '\n' ':')

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""   # prompt handled by Starship (see below)

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    aws
    web-search
)

source $ZSH/oh-my-zsh.sh

# Starship prompt (replaces OMZ theme; keeps plugins)
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt appendhistory

# Prefix-based history search
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

# LS_COLORS via dircolors (macOS coreutils provides gdircolors)
if [ -r "$HOME/.dircolors" ] && command -v gdircolors >/dev/null 2>&1; then
    eval "$(gdircolors "$HOME/.dircolors")"
fi

# Modern CLI replacements
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons'
    alias ll='eza -l --icons --git'
    alias la='eza -la --icons --git'
    alias lt='eza --tree --icons'
else
    # eza unavailable (no macOS prebuilt binary) — fall back to native ls
    alias ls='ls -G'
    alias ll='ls -lG'
    alias la='ls -laG'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat'
command -v rg  >/dev/null 2>&1 && alias grep='rg'
alias clip='pbcopy'
dclip() { { print -- "\$ ${(q-)@}"; "$@" 2>&1 } | tee >(pbcopy); return ${pipestatus[1]} }

# fzf (CTRL-R fuzzy history)
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

# AWS SSO profile switchers
awslogin() {
    local profile="$1"
    export AWS_PROFILE="$profile"

    if aws sts get-caller-identity --profile "$profile" >/dev/null 2>&1; then
        aws sts get-caller-identity --profile "$profile"
        return 0
    fi

    if aws sso login --profile "$profile"; then
        aws sts get-caller-identity --profile "$profile"
        return 0
    fi

    aws sso login --profile "$profile" --use-device-code
    aws sts get-caller-identity --profile "$profile"
}

awsdev()      { awslogin sandbox; }
awsadmin()    { awslogin admin; }
awslrpdev()   { awslogin lrp-sandbox; }
awslrpadmin() { awslogin lrp-admin; }

awswho() {
    aws sts get-caller-identity --profile "${AWS_PROFILE:-default}"
}

awslogout() {
    aws sso logout >/dev/null 2>&1
    unset AWS_PROFILE
}

# Project shortcuts
alias winnifred='uv run ~/repos/Winnifred/scripts/run-local.py'
alias cl='claude'

# iTerm2 shell integration
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh" || true

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# rbenv
eval "$(rbenv init -)"

# PATH
export PATH="$HOME/.npm-global/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# zoxide — must initialize last so its hooks aren't overridden by anything
# loaded later (NVM, PATH-dependent tools, etc.)
if command -v zoxide >/dev/null 2>&1; then
    alias ci='cdi'
    eval "$(zoxide init --cmd cd zsh)"
fi
